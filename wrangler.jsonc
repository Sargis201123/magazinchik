// Cloudflare Workers: игра (dist) + серверная часть оплаты звёздами (worker/index.ts).
// Секреты BOT_TOKEN и WEBHOOK_SECRET задаются в панели: Settings → Variables and Secrets (тип Secret).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magazinchik",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Раз в час бот напоминает тем, кто давно не заходил (api/_lib/social.ts; нужна база DB).
  "triggers": { "crons": ["15 * * * *"] },
  "vars": { "APP_URL": "https://magazinchik.sargis-zsx.workers.dev/" },
  // База для приглашений друзей и напоминаний; таблицы создаются сами (api/_lib/social.ts).
  "d1_databases": [{ "binding": "DB", "database_name": "magazinchik", "database_id": "ecb33cdd-e25b-4c41-bf92-45a2ff10dd4b" }]
}
