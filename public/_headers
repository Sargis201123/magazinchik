# Cloudflare: страницу игры не кэшировать — Telegram сразу получает новую версию.
# assets/: файлы сборки с хэшем в имени и картинки, к адресу которых игра дописывает отпечаток
# содержимого (?v=…, src/platform/assets.ts) — кэшировать надолго: перерисовали — сменился адрес.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
